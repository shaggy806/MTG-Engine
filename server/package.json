{
  "name": "server",
  "version": "1.0.0",
  "description": "Authoritative multiplayer host for MTG-Engine: owns Game instances and syncs seats over WebSocket",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && concurrently -k -n tsc,node -c blue,green \"tsc --watch --preserveWatchOutput\" \"node --watch dist/index.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "tsc && node scripts/smoke.mjs"
  },
  "dependencies": {
    "engine": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "vitest": "^4.1.11"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
